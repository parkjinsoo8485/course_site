-control size100\"   minlength=\"6\" maxlength=\"6\"  placeholder=\"OTP 인증번호를 입력하세요.\" class=\"form-control\" autocomplete=\"off\"  /></p>\r\n\t\t\t\t\t\t\t<p class=\"MAT5\">※ 구글 OTP 인증 앱에 출력되는 <span class=\"text-danger\">6자리 번호</span>를 입력합니다.</p>\r\n\t\t\t\t\t\t\t<div class=\"error_msg error_otp_num\"></div>\t\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<div class=\"error_msg error_modal_message MAT10 text-center text-danger\" ></div>\t\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t</ul>\t\t\t\t\t\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"modal-close_btn text-center\">\r\n\t\t\t\t\t<p class=\"btn_auth2_bg\"><input type=\"submit\" name=\"submit\" value=\"2단계 인증\" class=\"btn btn-primary\" data-loading-text=\"처리중 ..\" /></p>\r\n\t\t\t\t</div>\r\n</form>\t\t\t\t\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n\t<script type=\"text/javascript\">\r\n\t\tfunction fm_comm_auth2_check(fm) {\r\n\t\t\tfm_ajax(fm);\r\n\t\t\treturn false;\r\n\t\t}\r\n\t</script>\r\n<!-- 모달 -->\r\n\r\n<!-- 모달 -->\r\n\t<div class=\"modal fade\" id=\"myModal\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\r\n\t\t<div class=\"modal-dialog\">\r\n\t\t\t<div class=\"modal-content\">\r\n\t\t\t\t<div class=\"modal-header\">\r\n\t\t\t\t\t<button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">×</button>\r\n\t\t\t\t\t<h4 class=\"modal-title\">알림</h4>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"modal-body\">\r\n\t\t\t\t\t<div class=\"message\"></div>\r\n\t\t\t\t\t<div class=\"error_msg\"></div>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"modal-close_btn text-center\">\r\n\t\t\t\t\t<p class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\"><a href=\"#none;\" class=\"btn btn-primary\">확인</a></p>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n<!-- 모달 -->\r\n\r\n\r\n<!-- 모달 -->\r\n<!-- 모달 -->\r\n\r\n<!-- 모달(담당자 정보 확인) -->\r\n<!-- 모달 -->\r\n\r\n<!-- 모달(새해) -->\r\n \t\r\n<!-- 모달 -->\r\n<!-- 모달(가격인상) --><!-- 모달 -->\r\n\r\n<!-- 알림 모달 -->\r\n<!-- 모달 -->\r\n\r\n<!-- 설문 모달 -->\r\n<!-- 모달 -->\r\n\r\n<script type=\"text/javascript\">\r\n\t$(window).load(function(){\r\n\t\tvar left_m = $('#left_menu')\r\n\t\t$(\".menu_btn\").click(function(){\r\n\t\t\tvar menu_btn_icon = $(this).children('i.fa')\r\n\t\t\t$(this).children('i.fa').toggleClass('fa-bars fa-arrow-left')\r\n\t\t\tvar m_btn = $(this)\r\n\t\t\t$(left_m).toggle('slide', { direction: 'left'}, 300 ,function(){\r\n\t\t\t\tif($(left_m).is(':hidden')){\r\n\t\t\t\t\t$('#le_on').css({\"display\":\"none\"})\r\n\t\t\t\t\t$('body').css({\"overflow\":\"\" , \"position\":\"\", \"width\":\"\"})\r\n\t\t\t\t\t$(m_btn).css({\"color\":\"\" ,\"background\":\"\"})\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$('#le_on').css({\"display\":\"block\", \"opacity\":\"0.5\"})\r\n\t\t\t\t\t$('body').css({\"overflow\":\"hidden\", \"position\":\"fixed\", \"width\":\"100%\"})\r\n\t\t\t\t\t$(m_btn).css({\"color\":\"#4791d2\" ,\"background\":\"#f4f4f4\"})\r\n\t\t\t\t\tif($('#le_on').css(\"attr\" ,\"block\")){\r\n\t\t\t\t\t\t$('#le_on').on(\"click\" ,function(){\r\n\t\t\t\t\t\t\t$('#le_on').css({\"display\":\"none\"})\r\n\t\t\t\t\t\t\t$(menu_btn_icon).removeClass().addClass('fa fa-bars')\r\n\t\t\t\t\t\t\t$('body').css({\"overflow\":\"\",\"position\":\"\" })\r\n\t\t\t\t\t\t\t$(m_btn).css({\"color\":\"\" ,\"background\":\"\"})\r\n\t\t\t\t\t\t\t$(left_m).hide();\r\n\t\t\t\t\t\t})\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t})\r\n\t\t});\r\n\r\n\r\n\t\t$(document).ready(function(){\r\n\t\t\t\r\n\t\t\t/*서비스 바로가기*/\r\n\t\t\t$('#header h1 a.btn_icon').click(function(){\r\n\t\t\t\t$(this).parent().children('a').find('i.fa').toggleClass('fa-angle-down fa-angle-up');\r\n\t\t\t\t$(this).parent().children().find('.my_service').toggle();\r\n\t\t\t})\r\n\t\t\r\n\r\n\t\t\tvar win_height = $(window).height()\r\n\t\t\tvar left_heigt = $('#left_menu').height()\r\n\t\t\tif(left_heigt > win_height){\r\n\t\t\t\t$('#left_menu').css({\"overflow\":\"scroll\", \"overflow-y\":\"auto\"})\r\n\t\t\t}\r\n\r\n\t\t\tvar url = document.location.href\r\n\t\t\tvar base_url = 'https://www.dbdbschool.kr/af/';\r\n\t\t\tvar service_dir = url.replace(base_url,\"\");\r\n\t\t\tvar chk_dir = service_dir.split(\"/\");\r\n\t\t\tvar chk_dir1 = chk_dir[0] + '/';\r\n\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\r\n\t\t\tvar chk_dir2 = chk_dir[0] + '/' + chk_dir[1] + '/';\r\n\t\t\tvar chk_url = base_url + chk_dir;\r\n\t\t\t\r\n\t\t\t\t\r\n\t\t\t\r\n\t\t\t// 1depth\r\n\t\t\t$('ul.parent>li>a').each(function(e){\r\n\t\t\t\tvar href = $(this).attr('href');\r\n\t\t\t\tif(href.match(chk_dir1)){\r\n\t\t\t\t\t$(this).addClass('on')\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$(this).removeClass('on')\r\n\t\t\t\t}\r\n\t\t\t})\r\n\r\n\t\t\t// 2depth\r\n\t\t\t$('ul.parent li ul li a').each(function(e){\r\n\t\t\t\tvar href = $(this).attr('href');\r\n\t\t\t\tif(href.match(chk_dir2)){\r\n\t\t\t\t\t$(this).addClass('on')\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$(this).removeClass('on')\r\n\t\t\t\t}\r\n\t\t\t})\r\n\r\n\t\t\t// 메인알림 닫기\r\n\t\t\t$(\"#notice_modal p.today_close\").click(function(){\r\n\t\t\t\tsetCookie( \"notiPopupClose\", \"yes\" , 1); \r\n\t\t\t\t$('#notice_modal').modal('hide')\r\n\t\t\t\t\r\n\t\t\t});\r\n\t\t\t\r\n\t\t\t// 설문알림 닫기\r\n\t\t\t$(\"#survey_modal p.today_close\").click(function(){\r\n\t\t\t\tsetCookie( \"afSurveyPopupClose\", \"yes\" , 1); \r\n\t\t\t\t$('#survey_modal').modal('hide')\r\n\t\t\t\t\r\n\t\t\t});\r\n\t\t\t\r\n\t\t\t// 알림\r\n\t\t\t$('#yunjang_modal').modal('show');\r\n\t\t\t$('#notice_modal').modal('show');\r\n\t\t\t$('#survey_modal').modal('show');\r\n\t\t\t$('#admin_info_modal').modal('show');\t\t\t\t\t\r\n\t\t\t//$('#price_modal').modal('show');\r\n\t\t\t$('#new_year_modal').modal('show');\r\n\t\t\t$('#new_sms_modal').modal('show');\r\n\t\t\t\r\n\t\t})\r\n\r\n\t\t$(window).resize(function(){\r\n\t\t\tvar w = $(window).width();\r\n\t\t\tif(w > 1024 && $(left_m).is(':hidden')) {\r\n\t\t\t\t$(left_m).removeAttr('style');\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\t$('.user dt strong').click(function(){\r\n\t\t\t$(this).find('i.fa').toggleClass('fa-angle-up fa-angle-down')\r\n\t\t})\r\n\r\n\r\n\t\t// { 모달경고창\r\n\t\t$('#myModal').on('hidden.bs.modal', function () {\r\n\t\t\tclose_modal();\r\n\t\t});\r\n\r\n\t\tshow_modal();\r\n\t\t// }\r\n\r\n\t\t//주요기능(검색, 버튼)셀렉트 형식 { \r\n\t\tif($('a.main_control_box_btn').size()){\r\n\t\t\tvar main_control_box_btn_var = $('a#main_control_box_btn01')\r\n\t\t\t//검색 {\r\n\t\t\t\t$('#main_control_box_btn01').click(function(){\r\n\t\t\t\t\tvar main_control_module = $(this).next('#main_control_box_search')\r\n\t\t\t\t\tmain_control_module.toggle();\r\n\t\t\t\t\t$(window).resize(function(){\r\n\t\t\t\t\t\tvar w = $(window).width();\r\n\t\t\t\t\t\tif(w > 1024) {\r\n\t\t\t\t\t\t\tmain_control_module.show();\r\n\t\t\t\t\t\t\tmain_control_module.attr('style' , '');\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t\tif($(main_control_module).is(':visible')){\r\n\t\t\t\t\t\t$(main_control_box_btn_var).children('strong').html('닫기');\r\n\t\t\t\t\t\t$(main_control_box_btn_var).children('span').removeClass().addClass('fa fa-angle-up')\r\n\t\t\t\t\t\tsetCookie( \"mainSearchBox\", \"open\" , 0); \r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t$(main_control_box_btn_var).children('strong').html('열기');\r\n\t\t\t\t\t\t$(main_control_box_btn_var).children('span').removeClass().addClass('fa fa-angle-down')\r\n\t\t\t\t\t\tsetCookie( \"mainSearchBox\", \"close\" , 0); \r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\r\n\t\t\t\tif (getCookie(\"mainSearchBox\") == 'open'){\r\n\t\t\t\t\tvar main_control_module = $(this).next('#main_control_box_search');\r\n\t\t\t\t\tmain_control_module.show();\r\n\t\t\t\t\tif(main_control_module.is(':visible')){\r\n\t\t\t\t\t\t$(main_control_box_btn_var).children('strong').html('닫기');\r\n\t\t\t\t\t\t$(main_control_box_btn_var).children('span').removeClass().addClass('fa fa-angle-up')\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t$(window).resize(function(){\r\n\t\t\t\t\t\t\tvar w = $(window).width();\r\n\t\t\t\t\t\t\tif(w > 1024) {\r\n\t\t\t\t\t\t\t\tmain_control_module.show();\r\n\t\t\t\t\t\t\t\tmain_control_module.attr('style' , '');\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t\t$(main_control_box_btn_var).children('strong').html('열기');\r\n\t\t\t\t\t\t$(main_control_box_btn_var).children('span').removeClass().addClass('fa fa-angle-down')\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t//}\r\n\t\t\t//버튼{\r\n\t\t\t\t$('#main_control_box_btn02').click(function(){\r\n\t\t\t\t\tvar main_control_module = $(this).next('#main_control_box_drop')\r\n\t\t\t\t\t$(this).children('span').toggleClass('fa-angle-down fa-angle-up')\r\n\t\t\t\t\tmain_control_module.toggle();\r\n\t\t\t\t\t$(window).resize(function(){\r\n\t\t\t\t\t\tvar w = $(window).width();\r\n\t\t\t\t\t\tif(w > 1024) {\r\n\t\t\t\t\t\t\tmain_control_module.show();\r\n\t\t\t\t\t\t\tmain_control_module.attr('style' , '');\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t\tif($(main_control_module).is(':visible')){\r\n\t\t\t\t\t\t$(this).children('strong').html('닫기');\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t$(this).children('strong').html('열기');\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t//}\r\n\t\t}\r\n\t\t//}\r\n\t});\r\n\r\n\t// 연장신청, 가격인상 쿠키 셋\r\n\tfunction close_time_over_box(cookie_name, day) {\r\n\t\tsetCookie(cookie_name, 'yes' , day);\r\n\t}\r\n\r\n\tfunction show_modal(msg, emsg, title, show_btn) {\t\t\r\n\t\tvar $obj = $('#myModal');\r\n\t\t\r\n\t\tif (show_btn == undefined) {\r\n\t\t\tshow_btn = true;\r\n\t\t}\r\n\t\tif (show_btn == false) {\r\n\t\t\t$obj.find('div.modal-close_btn').css('display', 'none');\r\n\t\t} else {\r\n\t\t\t$obj.find('div.modal-close_btn').css('display', 'block');\r\n\t\t}\r\n\t\t\r\n\t\tif (!title) { title = '알림'; }\r\n\t\t$obj.find('div.modal-header h4.modal-title').html(title);\r\n\t\t\r\n\t\tif(msg) {\r\n\t\t\t$obj.find('div.modal-body div.message').html(msg);\r\n\t\t}\r\n\t\tif(emsg) {\r\n\t\t\t$obj.find('div.modal-body div.error_msg').html(emsg);\r\n\t\t}\r\n\r\n\t\tif(msg || emsg || $obj.find('div.modal-body div.message').html() \r\n\t\t\t|| $obj.find('div.modal-body div.error_msg').html())\r\n\t\t{\r\n\t\t\t$obj.modal();\r\n\t\t\tmsg_input_on();\r\n\t\t}\r\n\t}\r\n\r\n\tfunction close_modal(mode) {\r\n\t\tvar $obj = $('#myModal');\r\n\t\t\r\n\t\tif (!mode) { mode = 'clear'; }\r\n\t\tif (mode == 'hide') {\r\n\t\t\t// 닫힘 이벤트 발생\r\n\t\t\t$obj.modal('hide');\t\t\t\r\n\t\t} else {\r\n\t\t\t// 초기화, 닫힘 이벤트시 자동 호출\r\n\t\t\t$obj.find('div.modal-header h4.modal-title').html('알림');\r\n\t\t\t$obj.find('div.modal-body div.message').html('');\r\n\t\t\t$obj.find('div.modal-body div.error_msg').html('');\r\n\t\t}\r\n\t}\r\n\t\r\n\tfunction msg_input_on(){\r\n\t\t$('form div.error_msg').each(function(e){\r\n\t\t\tvar msg_u = $(this);\t\t\r\n\t\t\t\r\n\t\t\tvar class_list = $(this).attr('class');\r\n\t\t\tvar target_input = '';\r\n\t\t\tclass_list = class_list.split(' ');\r\n\t\t\tif(class_list.length > 1) {\r\n\t\t\t\tfor(ii = 1; ii < class_list.length; ii++) {\r\n\t\t\t\t\tvar target_input = class_list[ii];\r\n\t\t\t\t\tif(target_input.search('error_') == 0) {\r\n\t\t\t\t\t\ttarget_input = target_input.replace('error_', '');\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\tif($(msg_u).children('p').size() > 0){\r\n\t\t\t\tif(!target_input) { $(msg_u).parent().children('.form-control').addClass('error_msg_on'); }\r\n\t\t\t\telse {\r\n\t\t\t\t\t$('#' + target_input).addClass('error_msg_on'); \r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tif(!target_input) { $(msg_u).parent().children('.form-control').removeClass('error_msg_on'); }\r\n\t\t\t\telse {\r\n\t\t\t\t\t$('#' + target_input).removeClass('error_msg_on'); \r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\t\r\n\t/* 도움말 동영상 링크 box */\r\n\tfunction help_video_list(mode) {\r\n\t\t\r\n\t\tvar curr_display = $('#help_video').css('display');\r\n\t\tif (mode == 'toggle') {\r\n\t\t\tif (curr_display == 'block') { mode = 'hide'; }\r\n\t\t\telse { mode = 'show'; }\r\n\t\t}\r\n\t\tif(mode == 'show') {\r\n\t\t\t$('#help_video').css('display', 'block');\r\n\t\t} else if(mode == 'hide') {\r\n\t\t\t$('#help_video').css('display', 'none');\r\n\t\t}\r\n\t}\r\n\r\n\tfunction openChatbotWin(dest) {\r\n\t\twindow.name = ''; // 이름이 같은 경우 새창 안뜨는 문제 처리\r\n\t\twin = window.open(dest, \"openChatbotWin\", \"scrollbars=yes,toolbar=no,status=yes,location=no,directories=no,width=1400,height=1000,resizable=no,menubar=no,left=10,top=10\");\r\n\t\twin.focus();\r\n\r\n\t\t// 2. 핵심 로직: 0.5 ~ 1초 뒤에 현재 페이지 상태 확인\r\n\t\tsetTimeout(function() {\r\n\t\t\t// document.hidden이 false라면 (= 내가 여전히 화면을 보고 있다면)\r\n\t\t\t// 사용자가 새 탭으로 이동하지 않았다고 판단합니다.\r\n\t\t\tif (!document.hidden && document.hasFocus()) {\r\n\t\t\t\talert(\"챗봇 창이 이미 실행 중입니다.\\n열려 있는 다른 창을 확인해 주세요.\");\r\n\t\t\t}\r\n\t\t}, 800); // 800ms 정도면 충분합니다.\r\n\t}\t\t\r\n</script>\r\n\r\n</body>\r\n</html><!-- div style=\"text-align:center; font-size:11px; color:#7E756B\">T:0.0093, M:0.74MB</div -->"
