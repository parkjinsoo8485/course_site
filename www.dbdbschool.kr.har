\t\t<input type=\"button\" value=\"취소\" onclick=\"location.href='https://www.dbdbschool.kr/af/ad_app/lists/p/1/sn/3267/sld/10/sof/sbh/sot/asc';\" class=\"btn btn-default btn-sm\" />\t\t\r\n\t\t\t<input type=\"submit\" value='엑셀 출력' class=\"btn btn-success btn-sm\" />\r\n\t\t</p>\t\t\r\n</form>\t\t\t\r\n\t</div>\t\r\n\r\n</div>\r\n\r\n<div class=\"help_box\">\r\n\t<div><b>&lt; 현재/이전 강좌 비교 &gt;</b></div>\r\n\t<ul class=\"MAT5\">\r\n\t\t<li>강좌를 '강좌전체'로 선택한 경우 강좌명이 같은 이전, 현재 강좌를 비교하여 취소자와 추가자를 출력합니다.</li>\r\n\t\t<li>신청 추가자 : 이전 강좌에는 신청하지 않고, 현재 강좌에는 신청한 학생입니다.</li>\r\n\t\t<li>신청 취소자 : 이전 강좌에는 신청되어 있고, 현재 강좌에는 신청하지 않은 학생입니다.</li>\r\n\t</ul>\r\n\r\n\t<div class=\"MAT10\"><b>&lt; 수강생의 추가일자 & 최종수강일(환불/취소) 기준 &gt;</b></div>\r\n\t<ul class=\"MAT5\">\r\n\t\t<li>신청 추가자 : 추가일자가 등록되어있는 학생입니다.</li>\r\n\t\t<li>신청 취소자 : 환불/취소 내역에 최종수강일이 등록되어있는 학생입니다.</li>\r\n\t</ul>\r\n</div>\t\r\n\r\n<form action=\"https://www.dbdbschool.kr/af/ad_app/search/p/1/sn/3267/sld/10/sof/sbh/sot/asc\" name=\"fm_search_lec_list\" id=\"fm_search_lec_list\" method=\"post\" accept-charset=\"utf-8\">\n                                                                                                                        <input type=\"hidden\" name=\"csrf_test_name\" value=\"91af4eea3bcf046bc1311cbd29be5b6a\" />\n<input type=\"hidden\" name=\"form_open_date_use_chk_csrf\" value=\"2026-08-19 14:15:08\" />\n\t<input type=\"hidden\" name=\"s_lec_div\" id=\"s_lec_div\" value=\"\" />\r\n</form>\r\n\r\n<script type=\"text/javascript\" src=\"https://s3-ap-northeast-2.amazonaws.com/www.dbdbschool.kr/js/form_common.js?190226\" charset=\"utf-8\"></script>\r\n<script type=\"text/javascript\" src=\"https://s3-ap-northeast-2.amazonaws.com/www.dbdbschool.kr/js/form_ajax.js\" charset=\"utf-8\"></script>\r\n<script type=\"text/javascript\">\r\n\tfunction fm_excel_check(fm) {\r\n\t\tvar excel_gubun = $('input:radio[name=excel_gubun]:checked').val();\r\n\t\tvar file_type = $('input:radio[name=file_type]:checked').val();\r\n\t\tvar com_gubun = $('input:radio[name=com_gubun]:checked').val();\r\n\t\t\r\n\t\tif(!com_gubun) {\r\n\t\t\talert('검색 조건 : 선택하세요.');\r\n\t\t\treturn false;\r\n\t\t}\r\n\r\n\t\t\t\r\n\t\tif(!validate_required(fm['sld'])) {\r\n\t\t\talert('현재 강좌(강좌구분) : 선택하세요.');\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(com_gubun == 1 && !validate_required(fm['sld2'])) {\r\n\t\t\talert('이전 강좌(강좌구분) : 선택하세요.');\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\t\r\n\t\tif(!excel_gubun) {\r\n\t\t\talert('출력 구분 : 선택하세요.');\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\t\r\n\t\tif(!file_type) {\r\n\t\t\talert('출력 파일 : 선택하세요.');\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\t\r\n\t\tif(confirm('출력하시겠습니까?\\n\\n(데이터가 많은 경우 처리되는 시간이 다소 지연될 수 있습니다.)')) {\r\n\t\t\treturn true;\r\n\t\t}\r\n\t\treturn false;\t\t\r\n\t}\r\n\t\r\n\r\n\tfunction chk_tr_sld2() {\r\n\t\t$('#tr_sld2').hide();\r\n\t\t//alert($('#com_gubun_2').prop('checked'));\r\n\r\n\t\tif($('#com_gubun_1').prop('checked')) {\r\n\t\t\t$('#tr_sld2').show();\t\t\r\n\t\t} else if($('#com_gubun_2').prop('checked')) {\r\n\t\t\t$('#tr_sld2').hide();\t\t\t\t\t\r\n\t\t} \t\t\r\n\t}\r\n\r\n\t$(document).ready(function(){\r\n\t\tchk_tr_sld2();\r\n\t});\t\t\t\r\n\r\n\t// ------------------------------------------------------------------------------\r\n\tvar ajax_loding = false;\r\n\tvar ajax_pro_obj = null;\r\n\t\r\n\t// { 강좌 검색\r\n\tfunction search_lec_list(obj) {\r\n\t\t//var obj = $('#lec_div').get(0);\r\n\t\tvar lec_div = obj.value;\r\n\t\tvar msg = '';\r\n\t\t\r\n\t\tif(chk_ajax_loding()) { \r\n\t\t\treturn false;\r\n\t\t}\r\n\t\t\r\n\t\tif (obj.id == 'sld2') {\r\n\t\t\tvar target_id = 'sln2';\t\r\n\t\t} else {\t\t\t\r\n\t\t\tvar target_id = 'sln';\t\t\t\r\n\t\t}\r\n\t\r\n\t\t// 초기화\t\r\n\t\t$('#' + target_id + ' > option').each(function() {\r\n\t\t\tif(this.value.length != 0) {\r\n\t\t\t\t$(this).remove();\t\t\t\r\n\t\t\t}\r\n            //options.push({value: $(this).val(), text: $(this).text()});\r\n\t\t});\r\n\t\t\r\n\t\tif (!lec_div) {\r\n\t\t\t// 강좌목록 초기화\r\n\t\t\treturn true;\r\n\t\t}\r\n\t\t\r\n\t\t$('#s_lec_div').val(lec_div);\t\t\r\n\t\r\n\t\tcallback = { 'before':fm_search_lec_list_before, 'error':fm_search_lec_list_error, 'success':fm_search_lec_list_success }\r\n\t\t//cfg = { 'async':false, 'msg_style':'modal', 'callback':callback }\r\n\t\tcfg = { 'callback':callback }\r\n\t\r\n\t\tajax_pro_obj = obj;\r\n\t\tfm_ajax($('#fm_search_lec_list').get(0), cfg);\r\n\t\treturn true;\r\n\t}\r\n\t\r\n\tfunction fm_search_lec_list_before(fm_id) {\r\n\t\tajaxLoding('show');\r\n\t}\r\n\t\r\n\tfunction fm_search_lec_list_error(xhr, textStatus, errorThrown, fm_id) {\r\n\t\tajaxLoding('hide');\r\n\t\r\n\t\tfm_search_lec_list_cancel(fm_id);\r\n\t}\r\n\t\r\n\tfunction fm_search_lec_list_success(json_data, fm_id) {\r\n\t\t// return 값 처리\r\n\t\tvar cnt = json_data.length;\r\n\t\tvar error = false;\t\t\r\n\t\tvar list_html = '';\r\n\t\tvar data_list = '';\r\n\t\t\r\n\t\tif (ajax_pro_obj.id == 'sld2') {\r\n\t\t\tvar $target = $('#sln2');\t\r\n\t\t} else {\t\t\t\r\n\t\t\tvar $target = $('#sln');\t\t\t\r\n\t\t}\r\n\t\t$.each(json_data, function(key, val){\r\n\t\t\tif(key == 'errors' && val['message']) {\r\n\t\t\t\terror = true;\r\n\t\t\t\tfm_search_lec_list_cancel(fm_id);\r\n\t\t\t} else if(key == 'list') {\r\n\t\t\t\t$target.index(0);\t\t\t\t\r\n\t\t\t\t$.each(val, function(key1, val1){\t\r\n\t\t\t\t\t// 적용\r\n\t\t\t\t\t$target.append('<option value=\"' + val1['num'] + '\">' + val1['title'] + '</option>');\r\n\t\t\t\t});\t\t\t\r\n\t\t\t}\r\n\t\t});\r\n\t\r\n\t\tajaxLoding('hide');\r\n\t}\r\n\t\r\n\tfunction fm_search_lec_list_cancel(fm_id) {\r\n\t\t//\r\n\t}\r\n\t\r\n\t// ajax loading\r\n\tfunction ajaxLoding(mode) {\r\n\t\tvar $obj = $(ajax_pro_obj);\r\n\t\r\n\t\tif(mode == 'show') {\r\n\t\t\tajax_loding = true;\r\n\t\t\t\r\n\t\t\tvar $loding = $('<div class=\"ajaxLoading1\"><img src=\"https://s3-ap-northeast-2.amazonaws.com/www.dbdbschool.kr/images/spinner_squares_circle.gif\" alt=\"loading\" /></div>');\r\n\t\t\tif($obj) { $loding.insertAfter($obj); } \r\n\t\r\n\t\t\t$loding.show(); \r\n\t\t} else if(mode == 'hide') {\r\n\t\t\tajax_loding = false;\r\n\t\r\n\t\t\tvar $loding = $obj.next('.ajaxLoading1');\r\n\t\t\t$loding.remove();\r\n\t\t}\r\n\t}\r\n\t\r\n\tfunction chk_ajax_loding() {\r\n\t\tif(ajax_loding) { \r\n\t\t\talert('이미 처리중인 내용이 있습니다.\\n\\n잠시후에 이용하세요.');\r\n\t\t\treturn true;\r\n\t\t}\r\n\t\r\n\t\treturn false;\r\n\t}\r\n</script>\t\t\t\t\t</div>\r\n\t\t\t\r\n\t\t\t<div id=\"footer\">\r\n\t\t\t\tCopyright ⓒ <span class=\"copyright_name\"><a href=\"http://www.xmecca.com\" target=\"_blank\"><strong>x</strong>mecca.com</a></span> All Rights Reserved.\r\n\t\t\t\t<br /><i class=\"fa fa-envelope\"></i> dbdbschool@naver.com\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n\r\n\t<!-- 동적 모달 box -->\r\n\t<div id=\"dynamicModalBox\" class=\"modal fade\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\"></div>\r\n\r\n<!-- 로그인 모달 -->\r\n\t<div class=\"modal fade\" id=\"login_Modal\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\" data-backdrop=\"static\" data-keyboard=\"false\">\r\n\t\t<div class=\"modal-dialog\">\r\n\t\t\t<div class=\"modal-content\">\r\n\t\t\t\t<div class=\"modal-header\">\r\n\t\t\t\t\t<!-- button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">×</button -->\r\n\t\t\t\t\t<h4 class=\"modal-title\"><i class=\"fa fa-meh-o\"></i>로그인 후 이용하세요.</h4>\r\n\t\t\t\t</div>\r\n<form action=\"https://www.dbdbschool.kr/member/login/sn/3267\" name=\"fm_comm_login\" id=\"fm_comm_login\" onsubmit=\"return fm_comm_login_check(this);\" method=\"post\" accept-charset=\"utf-8\">\n<input type=\"hidden\" name=\"csrf_test_name\" value=\"91af4eea3bcf046bc1311cbd29be5b6a\" />                      \n<input type=\"hidden\" name=\"form_open_date_use_chk_csrf\" value=\"2026-08-19 14:15:08\" />\n\t\t\t\t<div class=\"modal-body\">\r\n\t\t\t\t\t<ul class=\"in_box\">\r\n\t\t\t\t\t\t<li><input type=\"text\" name=\"login_id\" id=